{
  "name": "yumstash",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A modern web application for storing and managing your favorite recipes",
  "author": "Citingdude",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx nuxi typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/db/seed.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/hints": "1.0.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxt/test-utils": "4.0.0",
    "@nuxt/ui": "4.5.1",
    "@unhead/vue": "2.1.12",
    "@vueuse/core": "14.2.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "0.8.3",
    "eslint": "10.0.3",
    "neverthrow": "8.2.0",
    "nuxt": "4.4.2",
    "pg": "8.20.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vue": "3.5.30",
    "vue-router": "5.0.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.7.2",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/mdi": "1.2.3",
    "@types/pg": "8.18.0",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "0.31.9",
    "happy-dom": "^20.8.4",
    "tsx": "4.21.0",
    "vitest": "^4.1.0"
  }
}
