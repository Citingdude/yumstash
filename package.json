{
  "name": "yumstash",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "description": "A modern web application for storing and managing your favorite recipes",
  "author": "Citingdude",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx nuxi typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/db/seed.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "1.1.1",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "4.8.1",
    "@unhead/vue": "3.1.1",
    "@vueuse/core": "14.3.0",
    "culori": "4.0.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "v1.0.0-rc.3",
    "eslint": "10.4.1",
    "nuxt": "4.4.8",
    "pg": "8.21.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vue": "3.5.35",
    "vue-router": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/mdi": "1.2.3",
    "@types/node": "26.0.0",
    "@types/pg": "8.20.0",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "v1.0.0-rc.3",
    "tsx": "4.22.3",
    "vitest": "^4.1.7",
    "vue-tsc": "3.3.2"
  }
}
